{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/anti-slop/run-manifest.schema.json",
  "title": "Anti-Slop P0 Run Manifest",
  "description": "The data contract for a diagnose manifest. P0 defines and validates this shape but does not derive, write, or execute manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "mode", "repo_path", "snapshot_root", "status"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"const": "diagnose"},
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^/"},
    "snapshot_root": {"type": "string", "minLength": 1, "pattern": "^/"},
    "status": {"enum": ["passed", "stopped", "blocked", "rolled_back"]},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/checkRecord"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "minLength": 1},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "media_type": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "commandAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "argv", "cwd", "status"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "running", "passed", "failed", "skipped", "blocked", "not-run"]},
        "exit_code": {"type": ["integer", "null"]},
        "duration_ms": {"type": ["number", "null"], "minimum": 0},
        "stdout_artifact": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "stderr_artifact": {"anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]}
      }
    },
    "checkRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "passed", "failed", "skipped", "blocked", "not-run"]},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/commandAttempt"}},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check_id", "severity", "message"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "impact": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recommended_action": {"type": ["string", "null"]},
        "counterargument": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "column": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
