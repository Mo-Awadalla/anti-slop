{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/anti-slop/run-spec.schema.json",
  "title": "Anti-Slop P0 Run Specification",
  "description": "A read-only diagnose run. Runtime validation additionally verifies that check cwd values stay within snapshot_root and that argv contains no shell form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo_path", "snapshot_root", "mode", "checks"],
  "properties": {
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^/"},
    "snapshot_root": {"type": "string", "minLength": 1, "pattern": "^/"},
    "mode": {"const": "diagnose"},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/checkSpec"}
    }
  },
  "$defs": {
    "checkSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1, "default": "."},
        "shell": {"const": false, "default": false},
        "timeout_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
